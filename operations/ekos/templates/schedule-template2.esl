<?xml version="1.0" encoding="UTF-8"?>
<SchedulerList version='2.2'>
<Profile>C11</Profile>
    % for job in jobs:
    <Job>
        <JobType lead='true'/>
        <Name>${job['name']}</Name>
        <Group></Group>
        <Coordinates>
            <J2000RA>${job['ra']}</J2000RA>
            <J2000DE>${job['dec']}</J2000DE>
        </Coordinates>
        <OpticalTrain>Primary</OpticalTrain>
        <PositionAngle>-181</PositionAngle>
        <Sequence>${job['sequence']}</Sequence>
        <StartupCondition>
            <Condition>ASAP</Condition>
        </StartupCondition>
        <Constraints>
            <Constraint value='0'>MinimumAltitude</Constraint>
            <Constraint>EnforceTwilight</Constraint>
            <Constraint>EnforceArtificialHorizon</Constraint>
        </Constraints>
        <CompletionCondition>
            <Condition>Sequence</Condition>
        </CompletionCondition>
        <Steps>
            <Step>Track</Step>
            <Step>Focus</Step>
            <Step>Align</Step>
            <Step>Guide</Step>
        </Steps>
    </Job>
    % endfor
    <SchedulerAlgorithm value='1'/>
    <ErrorHandlingStrategy value='1'>
        <delay>0</delay>
    </ErrorHandlingStrategy>
    <StartupProcedure enabled='true'>
        <PostStartupQueue>/home/dokeeffe/code/bh-observatory/operations/ekos/startup-task-queue.kstarsqueue</PostStartupQueue>
    </StartupProcedure>
    <ShutdownProcedure enabled='true'>
        <PreShutdownQueue>/home/dokeeffe/code/bh-observatory/operations/ekos/shutdown-task-queue.kstarsqueue</PreShutdownQueue>
    </ShutdownProcedure>
</SchedulerList>
